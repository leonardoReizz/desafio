{
  "name": "@nexo/tickets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/server.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/server.ts",
    "seed": "node --env-file-if-exists=../../.env --import tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1",
    "@nexo/contracts": "workspace:*",
    "better-sqlite3": "^12",
    "hono": "^4",
    "tsx": "^4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7",
    "@types/node": "^22",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
