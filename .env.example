# ---- LLM (obrigatório para o agent) ----
ANTHROPIC_API_KEY=
# Modelo usado pelo agent. Ex.: claude-opus-5-5 (padrão) | claude-sonnet-5-5 | claude-haiku-5-5
LLM_MODEL=claude-opus-5-5

# ---- App web ----
# Segredo para assinar o cookie de sessão (gere com: openssl rand -hex 32)
SESSION_SECRET=
APP_DB_PATH=./data/app.db

# ---- Serviço de chamados (legado simulado) ----
TICKETS_SERVICE_URL=http://localhost:4001
# Token compartilhado web <-> serviço de chamados (gere com: openssl rand -hex 32)
TICKETS_SERVICE_TOKEN=
TICKETS_PORT=4001
TICKETS_DB_PATH=./data/tickets.db
# Simulação de instabilidade do legado (0 a 1) e latência base em ms
TICKETS_FAILURE_RATE=0.15
TICKETS_LATENCY_MS=150

# ---- Proteção de custo / abuso ----
RATE_LIMIT_PER_MINUTE=12
# Máximo de chamadas ao LLM por dia (0 = sem limite). Use em deploys públicos.
DEMO_DAILY_LLM_BUDGET=0
