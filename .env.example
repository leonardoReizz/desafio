# ---- LLM (obrigatório para o agent) ----
# Provider: fal (endpoint OpenAI-compatível do fal.ai, padrão) | anthropic (API da Anthropic direto)
LLM_PROVIDER=fal
# Chave do fal.ai (https://fal.ai/dashboard/keys) — usada quando LLM_PROVIDER=fal
FAL_KEY=
# Chave da Anthropic — usada quando LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Modelo (vazio = padrão do provider).
#   fal:       anthropic/claude-opus-5.5 (padrão) | anthropic/claude-sonnet-5.5 | anthropic/claude-haiku-5.5
#   anthropic: claude-opus-5-5 (padrão) | claude-sonnet-5-5 | claude-haiku-5-5
LLM_MODEL=
# Esforço de raciocínio do modelo: low | medium | high (low = mais rápido e barato)
LLM_EFFORT=low

# ---- App web ----
APP_DB_PATH=./data/app.db

# ---- Serviço de chamados (legado simulado) ----
TICKETS_SERVICE_URL=http://localhost:4001
# Token compartilhado web <-> serviço de chamados (gere com: openssl rand -hex 32)
TICKETS_SERVICE_TOKEN=
TICKETS_PORT=4001
# Interface do serviço de chamados (na imagem Docker: 127.0.0.1, só o app web alcança)
TICKETS_HOST=0.0.0.0
TICKETS_DB_PATH=./data/tickets.db
# Simulação de instabilidade do legado (0 a 1) e latência base em ms
TICKETS_FAILURE_RATE=0.15
TICKETS_LATENCY_MS=150

# ---- Proteção de custo / abuso ----
RATE_LIMIT_PER_MINUTE=12
# Máximo de chamadas ao LLM por dia (0 = sem limite). Use em deploys públicos.
DEMO_DAILY_LLM_BUDGET=0
